{
    "name": "mervia/store-connector-laravel",
    "description": "Laravel helpers for the Mervia Store Connector: signed order webhook, product-page document store and print, attribution cookie, and endpoint stubs.",
    "type": "library",
    "license": "MIT",
    "require": {
        "php": "^8.1",
        "guzzlehttp/guzzle": "^7.5",
        "illuminate/bus": "^10.0|^11.0|^12.0|^13.0",
        "illuminate/http": "^10.0|^11.0|^12.0|^13.0",
        "illuminate/queue": "^10.0|^11.0|^12.0|^13.0",
        "illuminate/support": "^10.0|^11.0|^12.0|^13.0"
    },
    "require-dev": {
        "mockery/mockery": "^1.6",
        "orchestra/testbench": "^8.0|^9.0|^10.0|^11.0",
        "phpunit/phpunit": "^10.5|^11.0|^12.0",
        "symfony/yaml": "^6.0|^7.0|^8.0"
    },
    "autoload": {
        "psr-4": {
            "Mervia\\StoreConnector\\": "src/"
        }
    },
    "autoload-dev": {
        "psr-4": {
            "Mervia\\StoreConnector\\Tests\\": "tests/"
        }
    },
    "extra": {
        "laravel": {
            "providers": [
                "Mervia\\StoreConnector\\StoreConnectorServiceProvider"
            ]
        }
    },
    "config": {
        "sort-packages": true
    },
    "minimum-stability": "stable",
    "prefer-stable": true
}
